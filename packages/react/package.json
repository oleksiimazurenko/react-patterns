{
  "name": "@oleksiimazurenko/react-patterns",
  "version": "0.2.0",
  "description": "A growing collection of React best practices — each recipe done with as little client JS as possible. Import the whole set or a single recipe (fit-text, parallax, accordion, slider, …).",
  "keywords": [
    "react",
    "css",
    "zero-js",
    "server-first",
    "patterns",
    "best-practices",
    "fit-text",
    "parallax",
    "accordion",
    "slider"
  ],
  "license": "MIT",
  "author": "Oleksii Mazurenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleksiimazurenko/react-patterns.git",
    "directory": "packages/react"
  },
  "homepage": "https://react-patterns-demo-flax.vercel.app",
  "bugs": {
    "url": "https://github.com/oleksiimazurenko/react-patterns/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fit-text": {
      "types": "./dist/fit-text/index.d.ts",
      "import": "./dist/fit-text/index.js",
      "require": "./dist/fit-text/index.cjs"
    },
    "./parallax": {
      "types": "./dist/parallax/index.d.ts",
      "import": "./dist/parallax/index.js",
      "require": "./dist/parallax/index.cjs"
    },
    "./reveal": {
      "types": "./dist/reveal/index.d.ts",
      "import": "./dist/reveal/index.js",
      "require": "./dist/reveal/index.cjs"
    },
    "./accordion": {
      "types": "./dist/accordion/index.d.ts",
      "import": "./dist/accordion/index.js",
      "require": "./dist/accordion/index.cjs"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js",
      "require": "./dist/analytics/index.cjs"
    },
    "./scroll-progress": {
      "types": "./dist/scroll-progress/index.d.ts",
      "import": "./dist/scroll-progress/index.js",
      "require": "./dist/scroll-progress/index.cjs"
    },
    "./sticky-shrink": {
      "types": "./dist/sticky-shrink/index.d.ts",
      "import": "./dist/sticky-shrink/index.js",
      "require": "./dist/sticky-shrink/index.cjs"
    },
    "./slider": {
      "types": "./dist/slider/index.d.ts",
      "import": "./dist/slider/index.js",
      "require": "./dist/slider/index.cjs"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "import": "./dist/dialog/index.js",
      "require": "./dist/dialog/index.cjs"
    },
    "./popover": {
      "types": "./dist/popover/index.d.ts",
      "import": "./dist/popover/index.js",
      "require": "./dist/popover/index.cjs"
    }
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/**/index.js",
    "./dist/**/index.cjs"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oleksiimazurenko/patterns-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
