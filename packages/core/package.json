{
  "name": "@oleksiimazurenko/patterns-core",
  "version": "0.1.1",
  "description": "Framework-agnostic core for react-patterns — pure CSS building blocks (fit-text, parallax, accordion, slider, …) with zero runtime JS. Each recipe is a subpath export.",
  "keywords": [
    "css",
    "container-queries",
    "zero-js",
    "server-first",
    "patterns",
    "fit-text",
    "parallax",
    "accordion",
    "slider"
  ],
  "license": "MIT",
  "author": "Oleksii Mazurenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleksiimazurenko/react-patterns.git",
    "directory": "packages/core"
  },
  "homepage": "https://react-patterns-demo-flax.vercel.app",
  "bugs": {
    "url": "https://github.com/oleksiimazurenko/react-patterns/issues"
  },
  "exports": {
    "./fit-text/style.css": "./fit-text/style.css",
    "./parallax/style.css": "./parallax/style.css",
    "./reveal/style.css": "./reveal/style.css",
    "./accordion/style.css": "./accordion/style.css",
    "./scroll-progress/style.css": "./scroll-progress/style.css",
    "./sticky-shrink/style.css": "./sticky-shrink/style.css",
    "./slider/style.css": "./slider/style.css",
    "./dialog/style.css": "./dialog/style.css",
    "./popover/style.css": "./popover/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "fit-text",
    "parallax",
    "reveal",
    "accordion",
    "scroll-progress",
    "sticky-shrink",
    "slider",
    "dialog",
    "popover",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
